// expect-error: NITPICK-BORROW-002
// expect-error-at: 19:9
//
// PROBE 08g -- A `Cursor` DECLARED OUTSIDE A BLOCK, RE-BUILT INSIDE IT OVER THAT BLOCK'S `string`.
// EXPECTED REFUSED.
//
// The holder outlives the storage its new view names: `NITPICK-BORROW-002` at the assignment
// (D-004 rule 3, the compiler's DEF-42). The same reseat done by a CALLEE is refused too, from the
// compiler's landing 116 (`probe08h_view_reseated.npk`; at `7e91730` it read freed memory, DEF-252).
mod:probe08g_holder_outlives_view;

struct:Cursor = { fixed uint8[]:src; int64:pos; };

func:main = int32(cstring[]:_~argv) {
    string:s = string_concat("abc", "def");
    Cursor:c = Cursor{ src: string_bytes(s), pos: 0i64 };
    if (c.pos == 0i64) {
        string:t = string_concat("ghij", "klmn");
        c = Cursor{ src: string_bytes(t), pos: 1i64 };
    }
    if (c.src.len != 8i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
