// expect-error: NITPICK-TYPE-086
// expect-error-at: 11:5
//
// PROBE 08e -- A WRITE THROUGH A `fixed uint8[]`. EXPECTED REFUSED.
//
// The view is read-only through it: `NITPICK-TYPE-086` at the assignment. A reader that only
// reads its input loses nothing by declaring `fixed`.
mod:probe08e_write_through_fixed;

func:poke = NIL(fixed uint8[]:v) never fails {
    v[0i64] = 65u8;
    pass NIL;
};

func:main = int32(cstring[]:_~argv) {
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
