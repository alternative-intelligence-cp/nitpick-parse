// expect-error: NITPICK-BORROW-001
// expect-error-at: 15:10
//
// PROBE 08c -- A `Cursor` OVER A LOCAL `string`, RETURNED. EXPECTED REFUSED.
//
// Probe 08's fourth shape over a LOCAL instead of a parameter: `NITPICK-BORROW-001` at the
// struct literal the function passes. A reader's constructor may return a reader over the bytes
// it was HANDED, and never over bytes it made.
mod:probe08c_cursor_over_local_returned;

struct:Cursor = { fixed uint8[]:src; int64:pos; };

func:cursor_over_local = Cursor() never fails {
    string:s = string_concat("abc", "def");
    pass Cursor{ src: string_bytes(s), pos: 0i64 };
};

func:main = int32(cstring[]:_~argv) {
    Cursor:c = raw cursor_over_local();
    if (c.src.len != 6i64) { exit 10i32; }
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
