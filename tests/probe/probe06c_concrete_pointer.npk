// expect-exit: 1
//
// PROBE 06c -- PROBE 06's SECOND CONTROL: THE SAME CALL WITH NO BOUND. `drive(Count->:f)` calling the
// `Self->` method compiles, links and runs, at `c9baa9e` as at `7e91730`: the defect probe 06 met
// at `7e91730`, DEF-253, was the generic instance's.
mod:probe06c_concrete_pointer;

trait:Src = { func:step = int32(Self->:self); };

struct:Count = { int32:n; };
impl:Count:Src = {
    func:step = int32(Count->:self) {
        self.n = self.n + 1i32;
        pass self.n;
    };
};

func:drive = int32(Count->:f) {
    pass (relay f.step());
};

func:main = int32(cstring[]:_~argv) {
    Count:c = Count{ n: 0i32 };
    Result<int32>:r = drive(@c);
    if (r.is_error) { exit 20i32; }
    exit r.value;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (HeapBadRequest)    { exit 91i32; },
        (HeapOom)           { exit 92i32; },
        (IntOverflow)       { exit 93i32; },
        (Unreachable)       { exit 95i32; },
        (WildLeak)          { exit 96i32; },
        (StackExhausted)    { exit 106i32; },
        (MachineFault)      { exit 107i32; },
        (*)                 { exit 99i32; }
    }
    exit 9i32;
};
