+# THE TARGET EVERY MODULE STATES (the compiler's E-8, D-322 (5), its landing 71).
+# Every emission opens with a `target datalayout` and a `target triple` line, and
+# these two rows are what the runner holds them to: `datalayout` to what the
+# pinned `opt` derives from `triple`, and every linked program's two lines to
+# both (cycle 0.0.2's harness). Pins, not settings -- the compiler's runners
+# refuse a manifest without either, by name (its BUILD_REFERENCE.md §1) -- and
+# the layout is the FULL string: `llvm-as` completes a partial one, which then
+# fails the belt.
+triple        = "x86_64-unknown-linux-gnu"
+datalayout    = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
