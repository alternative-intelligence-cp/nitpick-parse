diff --git a/tests/probe/probe10_explicit_stack.npk b/tests/probe/probe10_explicit_stack.npk
new file mode 100644
index 0000000..7abddfb
--- /dev/null
+++ b/tests/probe/probe10_explicit_stack.npk
@@ -0,0 +1,119 @@
+// expect-exit: 0
+//
+// PROBE 10 -- FIFTY THOUSAND LEVELS OF NESTING ON AN EXPLICIT STACK.
+//
+// ASKS: a document of 50 000 `[` and 50 000 `]`, its depth tracked on a `Vec<Frame>` -- `[` pushes
+// a frame, `]` pops one -- rather than by native recursion. Does the explicit stack hold the whole
+// depth, balance, and free?
+//
+// DEPENDS ON THE ANSWER: PA-022 and `SAFETY.md` §5 -- no native recursion on input-controlled
+// depth -- and `EVENT_MODEL.md` §4's frame stack. `probe10b` is the other half.
+//
+// EXPECTED: exit 0 at -O0 and through `opt -O2`, and `Frame` -- `EVENT_MODEL.md` §4's own shape --
+// measuring the 16 bytes E-16 prices it at (code 11). A local named `stack` would be refused
+// (`stack` is a memory qualifier, `PLAYBOOK.md` §10), so the frames are `frames`.
+mod:probe10_explicit_stack;
+
+fixed int64:DEPTH = 50000i64;
+
+// The container, as small as the question needs: `Vec<T: Copy>`, the bound both sibling
+// libraries' `Vec` carries.
+struct:Vec<T: Copy> = { wild T->:items; int64:count; int64:cap; };
+
+func:vec_init<T: Copy> = Vec<T>(int64:cap) never fails {
+    int64:n = cap;
+    if (n < 1i64) { n = 1i64; }
+    wild int8->:mem = alloc(n * #size_of<T>());
+    pass Vec{ items: mem =>! wild T->, count: 0i64, cap: n };
+};
+
+func:vec_push<T: Copy> = NIL(Vec<T>->:v, T:x) never fails {
+    if (v.count == v.cap) {
+        int64:nc = v.cap * 2i64;
+        wild int8->:bigger = ralloc(v.items =>! wild int8->, nc * #size_of<T>());
+        v.items = bigger =>! wild T->;
+        v.cap = nc;
+    }
+    v.items[v.count] = x;
+    v.count = v.count + 1i64;
+    pass NIL;
+};
+
+func:vec_free<T: Copy> = NIL(Vec<T>->:v) never fails {
+    dalloc(v.items =>! wild int8->);
+    v.count = 0i64;
+    v.cap = 0i64;
+    pass NIL;
+};
+
+// The frame as `EVENT_MODEL.md` §4 declares it; E-16 prices it at 16 bytes, asserted below.
+#[derive(Copy)]
+enum:EventKind = { StartMap; EndMap; StartSeq; EndSeq; Key; Scalar; Comment; DocStart; DocEnd; };
+#[derive(Copy)]
+struct:Span = { uint32:lo; uint32:hi; };
+#[derive(Copy)]
+struct:Frame = { EventKind:kind; uint32:count; Span:span; };
+
+// One half of the document, walked on the caller's stack of frames.
+func:walk = NIL(fixed uint8[]:src, Vec<Frame>->:frames, int64->:deepest, int64->:bad) never fails {
+    for (int64:i in 0i64...src.len) {
+        if (src[i] == 91u8) {
+            drop vec_push(frames, Frame{ kind: EventKind.StartSeq, count: 0u32,
+                                         span: Span{ lo: (i =>! uint32), hi: (i =>! uint32) } });
+            if (frames.count > <-deepest) { <-deepest = frames.count; }
+        }
+        else if (src[i] == 93u8) {
+            if (frames.count == 0i64) { <-bad = 1i64; }
+            else { frames.count = frames.count - 1i64; }
+        }
+    }
+    pass NIL;
+};
+
+// The deepest nesting of DEPTH `[` then DEPTH `]`, or -1 if they do not balance.
+func:max_depth = int64(fixed uint8[]:opens, fixed uint8[]:closes) never fails {
+    Vec<Frame>:frames = raw vec_init::<Frame>(16i64);
+    int64:deepest = 0i64;
+    int64:bad = 0i64;
+    drop walk(opens, @frames, @deepest, @bad);
+    drop walk(closes, @frames, @deepest, @bad);
+    int64:left = frames.count;
+    drop vec_free(@frames);
+    if (bad != 0i64 || left != 0i64) { pass 0i64 - 1i64; }
+    pass deepest;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    string:brackets = string_concat("[", "");
+    string:shut = string_concat("]", "");
+    int64:n = 1i64;
+    int64:k = 0i64;
+    while (n < 65536i64) decreases 64i64 - k {
+        brackets = string_concat(brackets, brackets);
+        shut = string_concat(shut, shut);
+        n = n * 2i64;
+        k = k + 1i64;
+    }
+    fixed uint8[]:o = string_bytes(brackets);
+    fixed uint8[]:c = string_bytes(shut);
+    int64:d = raw max_depth(o[0i64...DEPTH], c[0i64...DEPTH]);
+    if (d != DEPTH) { exit 10i32; }
+    if (#size_of<Frame>() != 16i64) { exit 11i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (DecreasesViolated) { exit 108i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe10b_native_recursion_traps.npk b/tests/probe/probe10b_native_recursion_traps.npk
new file mode 100644
index 0000000..9c4f968
--- /dev/null
+++ b/tests/probe/probe10b_native_recursion_traps.npk
@@ -0,0 +1,68 @@
+// expect-exit: 106
+//
+// PROBE 10b -- NATIVE RECURSION OVER NESTED `[`, DEEPER THAN ANY STACK.
+//
+// ASKS: a recursive descent -- one native frame per `[` -- handed 1 048 576 of them. Does the
+// program die of a signal, or stop under control?
+//
+// DEPENDS ON THE ANSWER: PA-022's reason. Its text says the language has no stack-depth guard and
+// the overflow is "a raw fault, not a controlled stop"; `SAFETY.md` §5, `OPEN_QUESTIONS.md` O-N2
+// and five other documents say the same.
+//
+// EXPECTED: a CONTROLLED TRAP, `StackExhausted`, 106, at -O0 and through `opt -O2`: every
+// function the compiler emits checks its frame against the thread's limit in its prologue (the
+// compiler's D-305; the main thread runs on the floor's 8 MiB). So PA-022's rule stands -- a trap
+// stops the WHOLE program, which a hostile document must never do -- and its reason changes.
+// WHERE it traps is not the library's to know: measured at planning, this frame completes 65 534
+// levels and traps at 65 535 at -O0, and completes 131 062 and traps at 131 063 through `opt -O2`.
+// So fifty thousand levels -- the plan's first depth -- complete at both legs, and this probe
+// goes to 2^20.
+mod:probe10b_native_recursion_traps;
+
+fixed int64:LEVELS = 1048576i64;
+
+func:rd = int64(fixed uint8[]:src, int64:i) never fails {
+    int64:j = i + 1i64;
+    while (j < src.len) decreases src.len - j {
+        if (src[j] == 91u8) {
+            int64:k = raw rd(src, j);
+            if (k < 0i64) { pass k; }
+            j = k;
+        }
+        else if (src[j] == 93u8) { pass j + 1i64; }
+        else { j = j + 1i64; }
+    }
+    pass 0i64 - 1i64;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    string:t = string_concat("[", "");
+    int64:n = 1i64;
+    int64:k = 0i64;
+    while (n < LEVELS) decreases 64i64 - k {
+        t = string_concat(t, t);
+        n = n * 2i64;
+        k = k + 1i64;
+    }
+    fixed uint8[]:all = string_bytes(t);
+    int64:r = raw rd(all[0i64...LEVELS], 0i64);
+    // reached only if every level held: no `]`, so the answer is -1
+    if (r < 0i64) { exit 1i32; }
+    exit 2i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (DecreasesViolated) { exit 108i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/probe/probe11_bytes_growth.npk b/tests/probe/probe11_bytes_growth.npk
new file mode 100644
index 0000000..3074bb2
--- /dev/null
+++ b/tests/probe/probe11_bytes_growth.npk
@@ -0,0 +1,70 @@
+// expect-exit: 0
+//
+// PROBE 11 -- A MILLION SINGLE-BYTE APPENDS INTO A DOUBLING `buffer`-BACKED SINK.
+//
+// ASKS: the sink `Bytes` will be -- a managed `buffer` and a length -- grown by doubling: a new
+// `buffer_new` twice the size, the old bytes copied with `mcpy`, the old buffer dropped by the
+// assignment. The reallocations are counted. Is growth amortised linear?
+//
+// DEPENDS ON THE ANSWER: P-23 and P-24 (`0.0.4.md`) -- every writer and every escaped scalar
+// goes through this sink -- and the compiler's own measurement that this shape went quadratic in
+// `npkg`'s first full run.
+//
+// EXPECTED: exit 0 at -O0 and through `opt -O2`, with exactly twenty reallocations (1 -> 2 -> ...
+// -> 2^20), inside `log2(10^6) + 2`. Two facts the shape rests on at `7e91730`: a `buffer` cannot
+// be indexed or ranged (`NITPICK-TYPE-007` -- the compiler's D-341 plans it, unbuilt), so bytes
+// are written through `.ptr[i]`, a pointer index the language does not bounds-check; and nothing
+// here takes a view of the buffer.
+mod:probe11_bytes_growth;
+
+fixed int64:APPENDS = 1000000i64;
+
+struct:Sink = { buffer:buf; int64:len; int64:reallocs; };
+
+func:sink_init = Sink(int64:cap) never fails {
+    int64:n = cap;
+    if (n < 1i64) { n = 1i64; }
+    pass Sink{ buf: buffer_new(n), len: 0i64, reallocs: 0i64 };
+};
+
+func:sink_push = NIL(Sink->:s, uint8:x) never fails {
+    if (s.len == s.buf.len) {
+        buffer:bigger = buffer_new(s.buf.len * 2i64);
+        discard(mcpy(bigger.ptr, s.buf.ptr, s.len));
+        s.buf = move(bigger);
+        s.reallocs = s.reallocs + 1i64;
+    }
+    s.buf.ptr[s.len] = x;
+    s.len = s.len + 1i64;
+    pass NIL;
+};
+
+func:main = int32(cstring[]:_~argv) {
+    Sink:s = raw sink_init(1i64);
+    for (int64:i in 0i64...APPENDS) {
+        drop sink_push(@s, ((i % 251i64) =>! uint8));
+    }
+    if (s.len != APPENDS) { exit 10i32; }
+    if (s.reallocs > 21i64) { exit 11i32; }
+    if (s.reallocs != 20i64) { exit 12i32; }
+    if (s.buf.ptr[999999i64] != ((999999i64 % 251i64) =>! uint8)) { exit 13i32; }
+    if (s.buf.ptr[0i64] != 0u8) { exit 14i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
