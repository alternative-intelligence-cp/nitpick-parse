diff --git a/src/core/bytes.npk b/src/core/bytes.npk
new file mode 100644
index 0000000..e37ee74
--- /dev/null
+++ b/src/core/bytes.npk
@@ -0,0 +1,246 @@
+mod:bytes;
+
+// MAY IMPORT: nothing (`meta/specs/BUILD.md` B-17's table); `core` is the bottom layer.
+
+// `src/core/bytes.npk` -- `Bytes`, `nparse`'s byte sink (`meta/specs/BUILD.md` B-12, PA-004).
+//
+// The parser's scratch and every writer's output, and the ONLY allocating byte builder in the
+// library (the cycle plan's P-23): `string_concat` allocates per call, and output built that
+// way piece by piece is the shape the compiler measured as quadratic in `npkg`'s first full
+// run. A `Bytes` grows by doubling, so a million single-byte pushes are twenty reallocations
+// (`tests/probe/probe11_bytes_growth.npk` measured the shape; `tests/unit/bytes_growth.npk`
+// keeps it).
+//
+// ---- A `buffer` IS NOT BOUNDS-CHECKED, SO THIS FILE CHECKS ------------------------------
+//
+// The body is a managed `buffer` (P-24): it drops at scope exit, so a `Bytes` needs no free
+// and there is no free here to forget. A `buffer` cannot be indexed or ranged at the pin
+// (NITPICK-TYPE-007; the compiler's D-341 plans it, unbuilt), so its bytes are reached through
+// `.ptr`, a bare pointer, whose index is NOT checked (`VERIFICATION.md` §2). So every index
+// is checked in the function that uses it, before `.ptr` is touched: a read against `len`, a
+// write against the capacity, and `buf` is `hidden`, so no other module reaches `.ptr` at all
+// (NITPICK-TYPE-080). A misuse -- an index out of range, a negative capacity, a request whose
+// size no `int64` holds -- stops through `bytes_oob`, the language's own `OutOfBounds`, as
+// `vec.npk`'s stops do; this file has its own copy of that stop so that it imports nothing.
+//
+// ---- NO VIEW OF THE BYTES LEAVES THIS FILE ----------------------------------------------
+//
+// There is no `bytes_view`: a view of the body is invalidated by the next growth, which frees
+// the body under it (`nitpick-time`'s TM-139 measured the use-after-free), and a `buffer`
+// cannot be ranged anyway. The bytes leave one at a time (`bytes_at`) or all at once as an
+// OWNED copy (`bytes_take`). Every slice this file takes is a `fixed uint8[]`, read-only.
+//
+// ---- GROWTH DOUBLES, AND NO MULTIPLY CAN OVERFLOW ---------------------------------------
+//
+// `bytes_reserve` doubles the capacity, taking the request itself when doubling would pass
+// `int64`'s maximum, with the guard computed before every multiply; a request whose
+// `len + need` would overflow is refused before it is added. Every loop is a `for` over a
+// range, so none charges a consumer `DecreasesViolated`.
+//
+// `len` is `sealed` -- read anywhere, written only here (NITPICK-TYPE-079) -- and carries no
+// `limit<...>`, which would charge every consumer `LimitViolated`. A `Bytes` is move-only,
+// because a `buffer` owns: a copy is NITPICK-TYPE-046, a by-value parameter is a read-only
+// loan, and everything that changes one takes `Bytes->`.
+//
+// The obligations are comments in the syntax each would take (`VERIFICATION.md` P-1), each of
+// which compiles as a live clause at the pin (measured), and they stay comments for
+// `vec.npk`'s reason: live, each adds `RequiresViolated` or `EnsuresViolated` to every
+// consumer's bill.
+//
+// LAYERING (`BUILD.md` B-17): `core` imports nothing, and this file has no `use` line.
+
+// ---- the type ---------------------------------------------------------------------------
+
+pub struct:Bytes = {
+    hidden buffer:buf;      // MANAGED, owning, dropped at scope exit. `buf.len` is the CAPACITY.
+    sealed int64:len;       // bytes in use -- never `buf.len`
+};
+
+// `int64`'s maximum, the bound the growth guards are computed against.
+fixed int64:I64_MAX = 9223372036854775807i64;
+
+// ---- the stop ---------------------------------------------------------------------------
+
+// obligation: never fails ensures false
+//
+// `vec.npk`'s `vec_oob`, this file's copy: a one-element fixed array indexed at -1 or -2,
+// out of range at every `i`, so it never returns.
+func:bytes_oob = NIL(int64:i) never fails {
+    int64[1]:guard = [0i64];
+    int64:below = 0i64 - 1i64 - (i & 1i64);
+    discard(guard[below]);
+    pass NIL;
+};
+
+// ---- construction and reading -----------------------------------------------------------
+
+// obligation: never fails requires cap >= 0i64
+//             ensures result.len == 0i64 && result.buf.len >= 1i64
+//
+// A NEGATIVE CAPACITY IS A MISUSE AND STOPS; ZERO IS FLOORED TO ONE, as `vec_init` floors it.
+// `buffer_new(n)` is `n` zeroed bytes.
+pub func:bytes_init = Bytes(int64:cap) never fails {
+    if (cap < 0i64) { drop bytes_oob(cap); }
+    int64:n = cap;
+    if (n < 1i64) { n = 1i64; }
+    pass Bytes{ buf: buffer_new(n), len: 0i64 };
+};
+
+// obligation: never fails ensures result == b.len
+//
+// By value -- a loan, read-only -- as every reader here takes its `Bytes`.
+pub func:bytes_len = int64(Bytes:b) never fails {
+    pass b.len;
+};
+
+// obligation: never fails ensures result == b.buf.len
+//
+// THE CAPACITY, which only this file can read (`buf` is `hidden`): what a test asserts growth
+// with, and what `bytes_clear` keeps.
+pub func:bytes_capacity = int64(Bytes:b) never fails {
+    pass b.buf.len;
+};
+
+// obligation: never fails requires i >= 0i64 && i < b.len
+pub func:bytes_at = uint8(Bytes:b, int64:i) never fails {
+    if (i < 0i64) { drop bytes_oob(i); }
+    if (i >= b.len) { drop bytes_oob(i); }
+    pass b.buf.ptr[i];
+};
+
+// obligation: never fails ensures b.len == 0i64 && b.buf.len == old(b.buf.len)
+//
+// THE CAPACITY IS KEPT -- a sink reused across documents clears rather than reallocates --
+// and the old bytes are not zeroed: past `len` nothing here reads them.
+pub func:bytes_clear = NIL(Bytes->:b) never fails {
+    b.len = 0i64;
+    pass NIL;
+};
+
+// ---- growth -----------------------------------------------------------------------------
+
+// obligation: never fails requires need >= 0i64 ensures b.buf.len >= b.len + need
+//
+// ROOM FOR `need` MORE bytes, by doubling: a fresh `buffer_new`, the live bytes copied, and
+// the field overwritten, which drops the old body (there is no `buffer_resize`). Private: the
+// appends below are the surface.
+func:bytes_reserve = NIL(Bytes->:b, int64:need) never fails {
+    if (need < 0i64) { drop bytes_oob(need); }
+    if (need > I64_MAX - b.len) { drop bytes_oob(need); }
+    int64:want = b.len + need;
+    if (want <= b.buf.len) { pass NIL; }
+    int64:nc = b.buf.len;
+    if (nc < 1i64) { nc = 1i64; }
+    // The guard runs before every `nc * 2i64`; from 1, at most sixty-two doublings bring `nc`
+    // to 2^62 or past it, where it fires, so the sixty-third turn at the latest ends the loop
+    // in a `break` -- sixty-three, the value bits of an `int64`, as in `vec.npk`.
+    for (int64:k in 0i64...63i64) {
+        if (nc >= want) { break; }
+        if (nc > I64_MAX - nc) {
+            nc = want;
+            break;
+        }
+        nc = nc * 2i64;
+    }
+    if (nc < want) { nc = want; }
+    buffer:bigger = buffer_new(nc);
+    if (b.len > 0i64) {
+        discard(mcpy(bigger.ptr, b.buf.ptr, b.len));
+    }
+    b.buf = move(bigger);
+    pass NIL;
+};
+
+// ---- appending --------------------------------------------------------------------------
+
+// obligation: never fails ensures b.len == old(b.len) + 1i64
+pub func:bytes_push = NIL(Bytes->:b, uint8:x) never fails {
+    if (b.len >= b.buf.len) {
+        drop bytes_reserve(b, 1i64);
+        // `bytes_reserve`'s postcondition, checked where the write below relies on it.
+        if (b.len >= b.buf.len) { drop bytes_oob(b.len); }
+    }
+    b.buf.ptr[b.len] = x;
+    b.len = b.len + 1i64;
+    pass NIL;
+};
+
+// obligation: never fails ensures b.len == old(b.len) + src.len
+//
+// ONE COPY, not `src.len` pushes. The slice is a parameter, read-only, and only read.
+pub func:bytes_extend = NIL(Bytes->:b, fixed uint8[]:src) never fails {
+    if (src.len <= 0i64) { pass NIL; }
+    drop bytes_reserve(b, src.len);
+    if (src.len > b.buf.len - b.len) { drop bytes_oob(src.len); }
+    discard(mcpy(#ptr_add<uint8>(b.buf.ptr, b.len), src.ptr, src.len));
+    b.len = b.len + src.len;
+    pass NIL;
+};
+
+// obligation: never fails ensures b.len == old(b.len) + string_byte_length(s)
+//
+// `string_bytes` is a read-only view of `s` and allocates nothing.
+pub func:bytes_extend_str = NIL(Bytes->:b, string:s) never fails {
+    drop bytes_extend(b, string_bytes(s));
+    pass NIL;
+};
+
+// obligation: never fails ensures b.len > old(b.len)
+//
+// `v` IN DECIMAL, ALLOCATION-FREE: no `int_to_string`, no `string` at all. The digits are
+// written least-significant first into a local fixed array, then appended in reverse.
+// Twenty is the length of `uint64`'s maximum, 18446744073709551615 -- arithmetic, not
+// policy -- and every index into the array is the language's checked fixed-array index.
+// The loop always runs at least once, so zero writes the one digit "0" with no special
+// case; it stops when no digits remain, which twenty turns always reach. Measured with the
+// runtime's `NPK_HEAP_STATS`: a thousand renderings into a sink with room allocate nothing
+// (one allocation in the run, the sink's own; the same loop through `int_to_string`, 1001).
+//
+// WHAT IT COSTS A CONSUMER: its `%` and `/` arm `DivByZero` and `DivOverflow` in every
+// program that imports this file, whether or not it calls this function -- REACH is
+// import-scoped, and a literal divisor is no exemption (measured: this file's bill is ten
+// identities; the same file with the digits found by subtraction against descending powers
+// of ten, most significant first, is eight).
+pub func:bytes_put_uint = NIL(Bytes->:b, uint64:v) never fails {
+    uint8[20]:digits = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
+                        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
+    int64:n = 0i64;
+    uint64:x = v;
+    for (int64:k in 0i64...digits.len) {
+        // `x % 10u64` is 0 ... 9, so the narrowing is exact and `48u8 + d` is '0' ... '9'.
+        uint8:d = (x % 10u64) =>! uint8;
+        digits[k] = 48u8 + d;
+        x = x / 10u64;
+        n = k + 1i64;
+        if (x == 0u64) { break; }
+    }
+    drop bytes_reserve(b, n);
+    if (n > b.buf.len - b.len) { drop bytes_oob(n); }
+    for (int64:k in 0i64...n) {
+        b.buf.ptr[b.len + k] = digits[n - 1i64 - k];
+    }
+    b.len = b.len + n;
+    pass NIL;
+};
+
+// ---- handing the bytes over -------------------------------------------------------------
+
+// obligation: never fails ensures string_byte_length(result) == old(b.len) && b.len == 0i64
+//
+// THE BYTES, OUT, AS AN OWNED `string`, AND THE SINK EMPTIED. `string_from_bytes` is only a
+// VIEW of the body (cap 0, the compiler's own `Views` column), so the answer is that view
+// concatenated onto "" -- `string_concat` allocates and copies, and is `never fails` -- and it
+// is the caller's to keep: the sink's later growth frees the old body, never the answer.
+// Then `len` goes to 0 with the capacity kept: "take" leaves nothing behind, so a sink reused
+// for the next piece of output starts empty, and taking twice cannot hand the same bytes out
+// twice. It allocates by design, once per finished output -- never per piece.
+//
+// THE VIEW-RETURNING SHAPE IS REFUSED AT THE PIN, MEASURED: with the answer `string_from_bytes`
+// alone, `tests/unit/bytes_take.npk` is NITPICK-BORROW-015 at each write to the sink while the
+// taken string lives -- the compiler reads the answer as a possible view of `b.buf.ptr` and
+// freezes its root (D-325). The copy is what makes the answer free of the sink.
+pub func:bytes_take = string(Bytes->:b) never fails {
+    string:owned = string_concat("", string_from_bytes(b.buf.ptr, b.len));
+    b.len = 0i64;
+    pass owned;
+};
diff --git a/tests/unit/bytes_at_empty_traps.npk b/tests/unit/bytes_at_empty_traps.npk
new file mode 100644
index 0000000..90432cf
--- /dev/null
+++ b/tests/unit/bytes_at_empty_traps.npk
@@ -0,0 +1,37 @@
+// expect-exit: 94
+//
+// `bytes_at` AT 0 OF AN EMPTY `Bytes` STOPS `OutOfBounds`.
+//
+// `i == len == 0`, the index every guard of an empty container passes (`nitpick-regex`'s
+// RX-143).
+//
+// 94 is the failsafe's `OutOfBounds` arm, the language's own identity, which
+// `bytes_oob` raises: reaching it IS the assertion. Were the call to return, `main` would
+// end 50 -- never 94 -- so "the check fired" and "the check is gone" cannot look alike.
+// One case per file, because nothing runs after a trap.
+mod:bytes_at_empty_traps;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(4i64);
+    discard(raw bytes_at(b, 0i64));
+    exit 50i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
