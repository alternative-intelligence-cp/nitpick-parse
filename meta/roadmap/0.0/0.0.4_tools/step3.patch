diff --git a/tests/unit/bytes_extend.npk b/tests/unit/bytes_extend.npk
new file mode 100644
index 0000000..e41fb99
--- /dev/null
+++ b/tests/unit/bytes_extend.npk
@@ -0,0 +1,74 @@
+// expect-exit: 0
+//
+// `Bytes` -- `bytes_extend`, `bytes_extend_str` and `bytes_clear` (`src/core/bytes.npk`).
+//
+// Asserts: an empty slice and an empty string append nothing and do not grow it (10-12); a
+// string that fills the capacity exactly does not grow it (13, 14), and its bytes are there
+// (15, 16); a slice past the capacity grows it by doubling, 2 -> 4 -> 8 (17, 18), appends
+// after the old bytes (19, 20) and keeps them (21); a push fills the last spare byte without
+// growing (22); a 64-byte string grows 8 to 128 and lands whole (23-25);
+// `bytes_take` hands back every byte in order (26); `bytes_clear` empties and keeps the
+// capacity (27, 28), and the next append starts at 0 (29, 30). The slice `bytes_extend` takes
+// is `fixed uint8[]` -- here `string_bytes`'s read-only view -- and only read.
+mod:bytes_extend;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(2i64);
+    drop bytes_extend(@b, string_bytes(""));
+    if (b.len != 0i64)                                      { exit 10i32; }
+    if ((raw bytes_capacity(b)) != 2i64)                    { exit 11i32; }
+    drop bytes_extend_str(@b, "");
+    if (b.len != 0i64)                                      { exit 12i32; }
+
+    drop bytes_extend_str(@b, "ab");
+    if (b.len != 2i64)                                      { exit 13i32; }
+    if ((raw bytes_capacity(b)) != 2i64)                    { exit 14i32; }
+    if ((raw bytes_at(b, 0i64)) != 97u8)                    { exit 15i32; }
+    if ((raw bytes_at(b, 1i64)) != 98u8)                    { exit 16i32; }
+
+    drop bytes_extend(@b, string_bytes("cdefg"));
+    if (b.len != 7i64)                                      { exit 17i32; }
+    if ((raw bytes_capacity(b)) != 8i64)                    { exit 18i32; }
+    if ((raw bytes_at(b, 2i64)) != 99u8)                    { exit 19i32; }
+    if ((raw bytes_at(b, 6i64)) != 103u8)                   { exit 20i32; }
+    if ((raw bytes_at(b, 0i64)) != 97u8)                    { exit 21i32; }
+
+    drop bytes_push(@b, 104u8);
+    if ((raw bytes_capacity(b)) != 8i64)                    { exit 22i32; }
+
+    drop bytes_extend_str(@b, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
+    if (b.len != 72i64)                                     { exit 23i32; }
+    if ((raw bytes_capacity(b)) != 128i64)                  { exit 24i32; }
+    if ((raw bytes_at(b, 71i64)) != 102u8)                  { exit 25i32; }
+
+    string:all = raw bytes_take(@b);
+    if (!(string_equals(all, "abcdefgh0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"))) { exit 26i32; }
+
+    drop bytes_extend_str(@b, "xyz");
+    drop bytes_clear(@b);
+    if (b.len != 0i64)                                      { exit 27i32; }
+    if ((raw bytes_capacity(b)) != 128i64)                  { exit 28i32; }
+    drop bytes_extend_str(@b, "Q");
+    if (b.len != 1i64)                                      { exit 29i32; }
+    if ((raw bytes_at(b, 0i64)) != 81u8)                    { exit 30i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_growth.npk b/tests/unit/bytes_growth.npk
new file mode 100644
index 0000000..20ee19d
--- /dev/null
+++ b/tests/unit/bytes_growth.npk
@@ -0,0 +1,61 @@
+// expect-exit: 0
+//
+// `Bytes` -- A MILLION SINGLE-BYTE PUSHES FROM CAPACITY 1, AND EXACTLY TWENTY REALLOCATIONS
+// (probe 11's shape, made a unit of `src/core/bytes.npk`).
+//
+// Asserts: a `Bytes` made at capacity 1 is empty (10) with capacity 1 (11); the capacity, read
+// after every push through `bytes_capacity`, changes only by exactly doubling (12) and only at
+// the push that found the body full (13) -- so each change IS one reallocation, and counting
+// changes counts them; the length is the push count (14); twenty reallocations, 1 -> 2 -> ...
+// -> 2^20, the first power of two past a million, inside `log2(10^6) + 2` (15, 16); and every
+// byte survived every reallocation, read back by `bytes_at`, the first and last named apart
+// (17-19). The body is managed and drops at scope exit, so `exit 0` here asserts no `wild`
+// block and says nothing about it (`SAFETY.md` S-18); the reallocation count is what bounds
+// the growth.
+mod:bytes_growth;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(1i64);
+    if ((raw bytes_len(b)) != 0i64)                         { exit 10i32; }
+    if ((raw bytes_capacity(b)) != 1i64)                    { exit 11i32; }
+    int64:reallocs = 0i64;
+    int64:seen_cap = 1i64;
+    for (int64:i in 0i64...1000000i64) {
+        drop bytes_push(@b, ((i % 251i64) =>! uint8));
+        int64:now_cap = raw bytes_capacity(b);
+        if (now_cap != seen_cap) {
+            if (now_cap != seen_cap * 2i64)                 { exit 12i32; }
+            if (i != seen_cap)                              { exit 13i32; }
+            reallocs = reallocs + 1i64;
+            seen_cap = now_cap;
+        }
+    }
+    if (b.len != 1000000i64)                                { exit 14i32; }
+    if (reallocs != 20i64)                                  { exit 15i32; }
+    if ((raw bytes_capacity(b)) != 1048576i64)              { exit 16i32; }
+    if ((raw bytes_at(b, 0i64)) != 0u8)                     { exit 17i32; }
+    if ((raw bytes_at(b, 999999i64)) != ((999999i64 % 251i64) =>! uint8)) { exit 18i32; }
+    for (int64:j in 0i64...1000000i64) {
+        if ((raw bytes_at(b, j)) != ((j % 251i64) =>! uint8)) { exit 19i32; }
+    }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_init_negative_traps.npk b/tests/unit/bytes_init_negative_traps.npk
new file mode 100644
index 0000000..214d56e
--- /dev/null
+++ b/tests/unit/bytes_init_negative_traps.npk
@@ -0,0 +1,35 @@
+// expect-exit: 94
+//
+// `bytes_init` OF A NEGATIVE CAPACITY STOPS `OutOfBounds` (ZERO IS FLOORED TO ONE).
+//
+// As `vec_init`: a negative capacity is a misuse, not a hint.
+//
+// 94 is the failsafe's `OutOfBounds` arm, the language's own identity, which
+// `bytes_oob` raises: reaching it IS the assertion. Were the call to return, `main` would
+// end 50 -- never 94 -- so "the check fired" and "the check is gone" cannot look alike.
+// One case per file, because nothing runs after a trap.
+mod:bytes_init_negative_traps;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(0i64 - 1i64);
+    exit 50i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_put_uint.npk b/tests/unit/bytes_put_uint.npk
new file mode 100644
index 0000000..c368af7
--- /dev/null
+++ b/tests/unit/bytes_put_uint.npk
@@ -0,0 +1,69 @@
+// expect-exit: 0
+//
+// `bytes_put_uint` -- `uint64` IN DECIMAL, AT EVERY BOUNDARY A DIGIT LOOP GETS WRONG
+// (`src/core/bytes.npk`).
+//
+// Each value is rendered into a fresh `Bytes` of capacity 1 -- so every rendering of two or
+// more digits also grows it -- and the text `bytes_take` hands back is compared with the
+// expected text, and its length with the expected length: 0, the value whose loop writes one
+// digit without a special case (10); 1 and 9, the one-digit ends (11, 12); 10 and 99, 100 and
+// 1000, where the digit count changes (13-16); `int64`'s maximum (17); and `uint64`'s maximum,
+// twenty digits, the array's whole length (18). A `uint64` literal above `int64`'s maximum is NITPICK-LEX-004 at the pin -- the
+// literal envelope is signed -- so `uint64`'s maximum is built from `I64_MAX`, one multiply and
+// one add that cannot overflow. Then three renderings APPEND to one sink between other bytes,
+// each starting where the last ended (19, 20). The function allocates nothing of its own: its
+// digits go into a local `uint8[20]`, never through `int_to_string`.
+mod:bytes_put_uint;
+
+use "../../src/core/bytes.npk".*;
+
+fixed uint64:I64_MAX = 9223372036854775807u64;
+
+func:renders = bool(uint64:v, string:want) never fails {
+    Bytes:b = raw bytes_init(1i64);
+    drop bytes_put_uint(@b, v);
+    if (b.len != string_byte_length(want)) { pass false; }
+    string:got = raw bytes_take(@b);
+    pass string_equals(got, want);
+};
+
+func:main = int32(cstring[]:_~argv) {
+    uint64:umax = I64_MAX * 2u64 + 1u64;
+    if (!(raw renders(0u64, "0")))                          { exit 10i32; }
+    if (!(raw renders(1u64, "1")))                          { exit 11i32; }
+    if (!(raw renders(9u64, "9")))                          { exit 12i32; }
+    if (!(raw renders(10u64, "10")))                        { exit 13i32; }
+    if (!(raw renders(99u64, "99")))                        { exit 14i32; }
+    if (!(raw renders(100u64, "100")))                      { exit 15i32; }
+    if (!(raw renders(1000u64, "1000")))                    { exit 16i32; }
+    if (!(raw renders(I64_MAX, "9223372036854775807")))     { exit 17i32; }
+    if (!(raw renders(umax, "18446744073709551615")))       { exit 18i32; }
+
+    Bytes:s = raw bytes_init(1i64);
+    drop bytes_put_uint(@s, 12u64);
+    drop bytes_push(@s, 44u8);
+    drop bytes_put_uint(@s, 0u64);
+    drop bytes_push(@s, 44u8);
+    drop bytes_put_uint(@s, umax);
+    if (s.len != 25i64)                                     { exit 19i32; }
+    string:joined = raw bytes_take(@s);
+    if (!(string_equals(joined, "12,0,18446744073709551615"))) { exit 20i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/bytes_take.npk b/tests/unit/bytes_take.npk
new file mode 100644
index 0000000..d9d8001
--- /dev/null
+++ b/tests/unit/bytes_take.npk
@@ -0,0 +1,62 @@
+// expect-exit: 0
+//
+// `bytes_take` -- AN OWNED COPY OF THE BYTES, AND THE SINK LEFT EMPTY (`src/core/bytes.npk`).
+//
+// Asserts: the string taken is the text appended (10); the sink is empty after it (11) with its
+// capacity kept (12). THE STRING IS A COPY, NOT A VIEW: the sink then grows past its old
+// capacity -- which frees the body a view would point into, and the runtime poisons every
+// freed byte (0xAA) -- and the string still reads its text (13, 14); the sink is cleared and
+// refilled over the same bytes and the string is unchanged (15). A second take hands out only
+// what was appended since (16), and a take of an empty sink is the empty string (17, 18). A
+// push after a take starts at 0 (19, 20). `nitpick-regex` (RX-138) and `nitpick-time` (TM-188)
+// each shipped a take that returned the view. At the pin that shape does not reach a run: with
+// `bytes_take` answering `string_from_bytes` alone, this file is NITPICK-BORROW-015 at each
+// write to `b` while `first` lives (measured); 14 and 15 are the run-time half, for a view the
+// borrow check would not see.
+mod:bytes_take;
+
+use "../../src/core/bytes.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Bytes:b = raw bytes_init(4i64);
+    drop bytes_extend_str(@b, "abcd");
+    string:first = raw bytes_take(@b);
+    if (!(string_equals(first, "abcd")))                    { exit 10i32; }
+    if (b.len != 0i64)                                      { exit 11i32; }
+    if ((raw bytes_capacity(b)) != 4i64)                    { exit 12i32; }
+
+    drop bytes_extend_str(@b, "0123456789");
+    if ((raw bytes_capacity(b)) != 16i64)                   { exit 13i32; }
+    if (!(string_equals(first, "abcd")))                    { exit 14i32; }
+    drop bytes_clear(@b);
+    drop bytes_extend_str(@b, "WXYZ");
+    if (!(string_equals(first, "abcd")))                    { exit 15i32; }
+
+    string:second = raw bytes_take(@b);
+    if (!(string_equals(second, "WXYZ")))                   { exit 16i32; }
+    string:none = raw bytes_take(@b);
+    if (string_byte_length(none) != 0i64)                   { exit 17i32; }
+    if (!(string_equals(none, "")))                         { exit 18i32; }
+
+    drop bytes_push(@b, 113u8);
+    if (b.len != 1i64)                                      { exit 19i32; }
+    if ((raw bytes_at(b, 0i64)) != 113u8)                   { exit 20i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (DivByZero)         { exit 97i32; },
+        (DivOverflow)       { exit 98i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
