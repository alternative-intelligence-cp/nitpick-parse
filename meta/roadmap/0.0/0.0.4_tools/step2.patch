+++ b/tests/unit/vec_leak_freed.npk
@@ -0,0 +1,48 @@
+// expect-exit: 0
+//
+// THE LEAK CONTROL'S PASSING HALF: every `Vec` freed, so `exit 0` is reached and ends 0
+// (`SAFETY.md` S-18; the compiler's D-151).
+//
+// A `Vec`'s block is `wild`, and a program that reaches `exit 0` with a `wild` block live traps
+// `WildLeak` (96) instead -- so this program's 0 is itself the assertion that `vec_free`
+// released each block, at both element shapes. Its twin, `vec_leak_forgotten_free.npk`, is the
+// same shape with one free left out and must end 96: a missing free is a trap, not a pass.
+//
+// Asserts beside the exit: each `vec_init` adds one live `wild` block and growth adds none --
+// `ralloc` moves the block (10); and after both frees the count is back where it started (11).
+mod:vec_leak_freed;
+
+use "../../src/core/vec.npk".*;
+
+#[derive(Copy)]
+struct:Cell = { int64:lo; int64:hi; };
+
+func:main = int32(cstring[]:_~argv) {
+    int64:before = wild_live_count();
+    Vec<int64>:a = raw vec_init::<int64>(1i64);
+    Vec<Cell>:c = raw vec_init::<Cell>(1i64);
+    for (int64:i in 0i64...1000i64) {
+        drop vec_push(@a, i);
+        drop vec_push(@c, Cell{ lo: i, hi: i + 1i64 });
+    }
+    if (wild_live_count() != before + 2i64)                 { exit 10i32; }
+    drop vec_free(@a);
+    drop vec_free(@c);
+    if (wild_live_count() != before)                        { exit 11i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/vec_ops.npk b/tests/unit/vec_ops.npk
new file mode 100644
index 0000000..9faca1c
--- /dev/null
+++ b/tests/unit/vec_ops.npk
@@ -0,0 +1,113 @@
+// expect-exit: 0
+//
+// `Vec<int64>` -- `vec_truncate`, `vec_clear`, `vec_fill`, `vec_reserve`, and `vec_init(0)`
+// (`src/core/vec.npk`).
+//
+// Asserts: `vec_truncate` past or at the count changes nothing (10-12), below it keeps the
+// first `n` with the capacity kept (13-16), and to 0 empties (17, 18); `vec_clear` empties and
+// keeps the capacity (19, 20), and the storage takes NEW values after it (21, 22); `vec_fill`
+// is "exactly `n` copies of `x`": from empty it builds `n` (23-26), at `n == count` it
+// overwrites in place without growing (27-30), above it shrinks (31, 32), at 0 empties (33),
+// and past the capacity it grows (34-37); `vec_reserve` makes room for `need` more beyond the
+// count, keeping the count and the elements (38-41), and with 0 changes nothing (42);
+// `vec_init(0)` is floored to capacity 1 and usable, growing on its second push (43-46). Every
+// `Vec` is freed, then `exit 0`.
+mod:vec_ops;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(2i64);
+    for (int64:i in 1i64...6i64) { drop vec_push(@v, i); }
+    // [1, 2, 3, 4, 5], capacity 8
+    int64:cap0 = v.cap;
+    drop vec_truncate(@v, 9i64);
+    if (v.count != 5i64)                                    { exit 10i32; }
+    if ((raw vec_at(v, 4i64)) != 5i64)                      { exit 11i32; }
+    drop vec_truncate(@v, 5i64);
+    if (v.count != 5i64)                                    { exit 12i32; }
+    drop vec_truncate(@v, 2i64);
+    // [1, 2]
+    if (v.count != 2i64)                                    { exit 13i32; }
+    if ((raw vec_at(v, 0i64)) != 1i64)                      { exit 14i32; }
+    if ((raw vec_at(v, 1i64)) != 2i64)                      { exit 15i32; }
+    if (v.cap != cap0)                                      { exit 16i32; }
+    drop vec_truncate(@v, 0i64);
+    if (v.count != 0i64)                                    { exit 17i32; }
+    if (v.cap != cap0)                                      { exit 18i32; }
+
+    drop vec_push(@v, 7i64);
+    drop vec_push(@v, 8i64);
+    drop vec_push(@v, 9i64);
+    drop vec_clear(@v);
+    if (v.count != 0i64)                                    { exit 19i32; }
+    if (v.cap != cap0)                                      { exit 20i32; }
+    drop vec_push(@v, 4i64);
+    if ((raw vec_at(v, 0i64)) != 4i64)                      { exit 21i32; }
+    if (v.count != 1i64)                                    { exit 22i32; }
+
+    drop vec_clear(@v);
+    drop vec_fill(@v, 3i64, 6i64);
+    // [6, 6, 6]
+    if (v.count != 3i64)                                    { exit 23i32; }
+    if ((raw vec_at(v, 0i64)) != 6i64)                      { exit 24i32; }
+    if ((raw vec_at(v, 1i64)) != 6i64)                      { exit 25i32; }
+    if ((raw vec_at(v, 2i64)) != 6i64)                      { exit 26i32; }
+    drop vec_fill(@v, v.count, 2i64);
+    // [2, 2, 2], in place
+    if ((raw vec_at(v, 0i64)) != 2i64)                      { exit 27i32; }
+    if ((raw vec_at(v, 2i64)) != 2i64)                      { exit 28i32; }
+    if (v.count != 3i64)                                    { exit 29i32; }
+    if (v.cap != cap0)                                      { exit 30i32; }
+    drop vec_fill(@v, 1i64, 9i64);
+    // [9]
+    if (v.count != 1i64)                                    { exit 31i32; }
+    if ((raw vec_at(v, 0i64)) != 9i64)                      { exit 32i32; }
+    drop vec_fill(@v, 0i64, 1i64);
+    if (v.count != 0i64)                                    { exit 33i32; }
+    drop vec_fill(@v, 20i64, 5i64);
+    // twenty 5s, past the capacity of 8
+    if (v.count != 20i64)                                   { exit 34i32; }
+    if (v.cap < 20i64)                                      { exit 35i32; }
+    if ((raw vec_at(v, 0i64)) != 5i64)                      { exit 36i32; }
+    if ((raw vec_at(v, 19i64)) != 5i64)                     { exit 37i32; }
+    drop vec_free(@v);
+
+    Vec<int64>:r = raw vec_init::<int64>(1i64);
+    drop vec_push(@r, 1i64);
+    drop vec_push(@r, 2i64);
+    drop vec_reserve(@r, 100i64);
+    if (r.cap < 102i64)                                     { exit 38i32; }
+    if (r.count != 2i64)                                    { exit 39i32; }
+    if ((raw vec_at(r, 0i64)) != 1i64)                      { exit 40i32; }
+    if ((raw vec_at(r, 1i64)) != 2i64)                      { exit 41i32; }
+    int64:cap1 = r.cap;
+    drop vec_reserve(@r, 0i64);
+    if (r.cap != cap1)                                      { exit 42i32; }
+    drop vec_free(@r);
+
+    Vec<int64>:z = raw vec_init::<int64>(0i64);
+    if (z.count != 0i64)                                    { exit 43i32; }
+    if (z.cap != 1i64)                                      { exit 44i32; }
+    drop vec_push(@z, 3i64);
+    drop vec_push(@z, 4i64);
+    if ((raw vec_at(z, 1i64)) != 4i64)                      { exit 45i32; }
+    if (z.cap != 2i64)                                      { exit 46i32; }
+    drop vec_free(@z);
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/vec_pod_struct.npk b/tests/unit/vec_pod_struct.npk
new file mode 100644
index 0000000..89c00d9
--- /dev/null
+++ b/tests/unit/vec_pod_struct.npk
@@ -0,0 +1,89 @@
+// expect-exit: 0
+//
+// `Vec<T>` AT A POD STRUCT THAT DERIVES `Copy` -- the second element shape `src/core/vec.npk`
+// must hold, beside the scalar of the other units.
+//
+// `Pt` owns nothing and says so with `#[derive(Copy)]`, which is all the compiler asks of it:
+// `Vec<T: Copy>` and every verb's bound accept it, where an owning `T` is NITPICK-TYPE-017. Its
+// three fields have three widths, so a read of the wrong slot or a short copy shows in a field.
+//
+// Asserts: three pushes from capacity 1 (two growths) read back field by field (10-13);
+// `vec_set` replaces one element whole (14, 15); `vec_insert` at 0 shifts every element up
+// (16-18); `vec_remove` at 0 returns the element by value (19); `vec_swap_remove` at 0 returns
+// it and moves the last into the hole (20, 21); `vec_pop` returns the last (22, 23); a read
+// is a COPY -- the slot still holds its element after it is read twice (24, 25); and
+// `vec_fill` writes `n` equal structs (26-28). Freed, then `exit 0`.
+mod:vec_pod_struct;
+
+use "../../src/core/vec.npk".*;
+
+#[derive(Copy)]
+struct:Pt = { int32:x; int64:y; uint8:tag; };
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<Pt>:v = raw vec_init::<Pt>(1i64);
+    drop vec_push(@v, Pt{ x: 1i32, y: 10i64, tag: 1u8 });
+    drop vec_push(@v, Pt{ x: 2i32, y: 20i64, tag: 2u8 });
+    drop vec_push(@v, Pt{ x: 3i32, y: 30i64, tag: 3u8 });
+    Pt:a = raw vec_at(v, 0i64);
+    Pt:c = raw vec_at(v, 2i64);
+    if (a.x != 1i32)                                        { exit 10i32; }
+    if (a.y != 10i64)                                       { exit 11i32; }
+    if (c.tag != 3u8)                                       { exit 12i32; }
+    if (v.count != 3i64)                                    { exit 13i32; }
+
+    drop vec_set(@v, 1i64, Pt{ x: 5i32, y: 50i64, tag: 5u8 });
+    // [P1, P5, P3]
+    Pt:b = raw vec_at(v, 1i64);
+    if (b.x != 5i32)                                        { exit 14i32; }
+    if (b.y != 50i64)                                       { exit 15i32; }
+
+    drop vec_insert(@v, 0i64, Pt{ x: 0i32, y: 0i64, tag: 9u8 });
+    // [P0, P1, P5, P3]
+    Pt:f = raw vec_at(v, 0i64);
+    Pt:g = raw vec_at(v, 1i64);
+    if (f.tag != 9u8)                                       { exit 16i32; }
+    if (g.x != 1i32)                                        { exit 17i32; }
+    if (v.count != 4i64)                                    { exit 18i32; }
+
+    Pt:r0 = raw vec_remove(@v, 0i64);
+    // [P1, P5, P3]
+    if (r0.tag != 9u8)                                      { exit 19i32; }
+    Pt:s0 = raw vec_swap_remove(@v, 0i64);
+    // [P3, P5]
+    if (s0.x != 1i32)                                       { exit 20i32; }
+    Pt:h = raw vec_at(v, 0i64);
+    if (h.y != 30i64)                                       { exit 21i32; }
+    Pt:p = raw vec_pop(@v);
+    // [P3]
+    if (p.y != 50i64)                                       { exit 22i32; }
+    if (v.count != 1i64)                                    { exit 23i32; }
+    Pt:once = raw vec_at(v, 0i64);
