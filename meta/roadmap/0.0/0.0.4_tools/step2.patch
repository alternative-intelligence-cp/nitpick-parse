diff --git a/src/core/vec.npk b/src/core/vec.npk
new file mode 100644
index 0000000..8a826d8
--- /dev/null
+++ b/src/core/vec.npk
@@ -0,0 +1,350 @@
+mod:vec;
+
+// MAY IMPORT: nothing (`meta/specs/BUILD.md` B-17's table); `core` is the bottom layer.
+
+// `src/core/vec.npk` -- `Vec<T>`, `nparse`'s growable array (`meta/specs/BUILD.md` B-12, PA-004).
+//
+// The compiler's `List<T>` in shape -- a block, a count, a capacity, doubling -- and ours
+// because a library must not import a compiler's internals (B-10). The block is `wild` (the
+// cycle plan's P-22): its lifetime is its owner's scope, so every scope that makes a `Vec`
+// calls `vec_free` on every path, or the program's `exit 0` traps `WildLeak` (D-151, S-18) --
+// which is the enforcement wanted, and `tests/unit/vec_leak_forgotten_free.npk` keeps it
+// measured.
+//
+// ---- THE ONE THING TO READ BEFORE CHANGING ANYTHING HERE --------------------------------
+//
+// `items` IS A `wild T->`, A BARE POINTER, AND AN INDEX THROUGH IT IS NOT CHECKED (D-070:
+// the bound lives in a slice's or a fixed array's type, never a pointer's; `SAFETY.md` §1's
+// indexing row, S-12). An out-of-range index here reads or writes whatever is there and
+// answers. So EVERY index and every count is checked IN THE FUNCTION THAT USES IT, before the
+// pointer is touched, and `items` is `hidden`, so no other module can index it at all
+// (NITPICK-TYPE-080). Signedness is half of every check: `i < v.count` admits a negative `i`,
+// so each accessor checks `i >= 0` as well.
+//
+// ---- WHAT A MISUSE DOES: IT TRAPS `OutOfBounds` -----------------------------------------
+//
+// An index out of range, a pop of an empty `Vec`, a negative capacity or count, a request
+// whose byte size no `int64` holds, and any use of a `Vec` after `vec_free` -- each is the
+// caller's mistake, and each stops the program through `vec_oob`, the language's own
+// `OutOfBounds` (exit 94 in this repository's `failsafe` convention). Not a `Result`: these
+// functions are `never fails`, so a consumer's hot loop threads no error channel, and the
+// library's error identities are `EParseState` and `EParseEncode` alone (`SAFETY.md` S-1),
+// which no module of `core` may import. Not an invented identity either: `vec_oob` indexes a
+// one-element fixed array, which carries its length, at an index out of range for EVERY
+// argument -- -1 or -2 -- so it cannot return (`nitpick-regex`'s RX-143: a stop that indexed
+// at `i` returned for `i == 0`, the index every guard on an EMPTY container passes; that
+// spelling here makes `tests/unit/vec_at_empty_traps.npk` end 50, measured).
+//
+// The obligations are COMMENTS, in the syntax each would take (`VERIFICATION.md` P-1), and each
+// compiles as a live clause at the pin (measured, one at a time). They stay comments because,
+// live, a `requires` traps `RequiresViolated` before the body's own check could -- changing the
+// identity a misuse stops with -- and each live clause adds `RequiresViolated` or
+// `EnsuresViolated` to every consumer's bill (measured). The comment is the clause; the checks
+// in the body are what run.
+//
+// ---- A FREED `Vec` IS DEAD, AND EVERY VERB TRAPS ON ONE ---------------------------------
+//
+// `vec_free` leaves `cap == 0`, `count == 0` and `items == NULL`. A `Vec` this file produced
+// otherwise always has `cap >= 1` (`vec_init` floors a request of 0 to 1), so `cap <= 0` means
+// freed, and every function here that is handed a `Vec` checks it FIRST: a push, a reserve or
+// a fill would otherwise grow a freed `Vec` from `ralloc(NULL, n)` -- a fresh block, and a use
+// after free that succeeds in silence -- and a second `vec_free` would reach `dalloc(NULL)`.
+//
+// ---- GROWTH DOUBLES, AND NO MULTIPLY CAN OVERFLOW ---------------------------------------
+//
+// Plain `int64` arithmetic traps on overflow (D-210), so every multiply is guarded BEFORE it
+// runs. The doubling (`vec_grown`) takes `want` itself when doubling would pass `int64`'s
+// maximum; the byte count (`vec_bytes`) is computed in `int128`, where two non-negative
+// `int64`s cannot overflow a product, and is refused through `vec_oob` when it does not fit an
+// `int64`; and a reservation's `count + need` is refused before it is added. A byte count that
+// fits an `int64` but that no allocator can give is the allocator's own trap: `HeapBadRequest`
+// past the runtime's 2^47 ceiling (measured: `vec_init::<int64>(2^60 - 1)` ends 91 at both
+// legs), `HeapOom` when memory runs out. Every loop here is a `for` over a range: none is a
+// `while`, so none needs a `decreases` measure and none charges a consumer `DecreasesViolated`.
+//
+// ---- WHAT A `Vec` MAY HOLD, AND THAT IT IS MOVE-ONLY -------------------------------------
+//
+// `T: Copy`, at the type and at every function (the compiler requires the bound repeated):
+// an element owns nothing (`SAFETY.md` S-15), so every read is a copy, `vec_at` can return by
+// value, and freeing the block is the whole free -- there is no element drop to forget.
+// An owning `T` is refused wherever it is written (NITPICK-TYPE-017). The last field,
+// `hidden string[0]:move_only`, holds nothing and occupies nothing -- a zero-length array of
+// an owning type -- and makes the `Vec` itself an owning type (`PLAYBOOK.md` §2's `T[0]` row):
+// a copy of a `Vec`, which would be a second handle on one block, is NITPICK-TYPE-046; a
+// transfer is `move(v)`. So a reader takes its `Vec` by value, which is a LOAN and read-only
+// (NITPICK-TYPE-085), and everything that changes one takes `Vec<T>->`.
+//
+// `count` and `cap` are `sealed`: read anywhere, written only here (NITPICK-TYPE-079), so a
+// consumer's struct literal of a `Vec` is refused too. No field carries a `limit<...>`: a
+// limited field charges every consumer `LimitViolated`, and the checks above stand in for it.
+//
+// LAYERING (`BUILD.md` B-17): `core` imports nothing, and this file has no `use` line.
+
+// ---- the type ---------------------------------------------------------------------------
+
+pub struct:Vec<T: Copy> = {
+    hidden wild T->:items;         // the block: `cap` slots, the first `count` live. WILD.
+    sealed int64:count;            // elements in use
+    sealed int64:cap;              // elements the block holds; 0 once freed
+    hidden string[0]:move_only;    // zero bytes, holds nothing -- and makes a `Vec` move-only
+};
+
+// `int64`'s maximum, the bound every guard below is computed against. It is spelled: the
+// MAXIMUM is inside the literal envelope (the minimum is not, NITPICK-LEX-004).
+fixed int64:I64_MAX = 9223372036854775807i64;
+
+// ---- the stop ---------------------------------------------------------------------------
+
+// obligation: never fails ensures false
+//
+// THE ONE OUT-OF-RANGE STOP IN THIS FILE. `i` is the value that was out of range, kept so a
+// call site says which; the index is `-1 - (i & 1)`, -1 or -2, out of range for this array
+// and for an array of any length, at every `i`.
+func:vec_oob = NIL(int64:i) never fails {
+    int64[1]:guard = [0i64];
+    int64:below = 0i64 - 1i64 - (i & 1i64);
+    discard(guard[below]);
+    pass NIL;
+};
+
+// ---- the guarded arithmetic -------------------------------------------------------------
+
+// obligation: never fails requires n >= 0i64 ensures result >= 0i64
+//
+// `n` ELEMENTS' BYTES, or a stop when they do not fit an `int64`. Both factors are `int64`s
+// at least zero, so their `int128` product is below 2^126 and the multiply cannot overflow;
+// the comparison is the guard, and the narrowing below it is exact.
+func:vec_bytes<T: Copy> = int64(int64:n) never fails {
+    int128:wide = (n => int128) * (#size_of<T>() => int128);
+    if (wide > (I64_MAX => int128)) { drop vec_oob(n); }
+    pass wide =>! int64;
+};
+
+// obligation: never fails requires want >= 1i64 ensures result >= want
+//
+// THE CAPACITY THAT HOLDS `want`: `from` doubled until it does, and `want` itself if the next
+// doubling would pass `int64`'s maximum. The guard `nc > I64_MAX - nc` runs before every
+// `nc * 2i64` and cannot overflow (`nc >= 0`). From `nc >= 1`, at most sixty-two doublings
+// bring `nc` to 2^62 or past it, where the guard fires, so the sixty-third turn at the
+// latest ends the loop in a `break` -- sixty-three, the value bits of an `int64`; the line
+// after the loop makes the postcondition hold whatever it did.
+func:vec_grown = int64(int64:from, int64:want) never fails {
+    int64:nc = from;
+    if (nc < 1i64) { nc = 1i64; }
+    for (int64:k in 0i64...63i64) {
+        if (nc >= want) { break; }
+        if (nc > I64_MAX - nc) {
+            nc = want;
+            break;
+        }
+        nc = nc * 2i64;
+    }
+    if (nc < want) { nc = want; }
+    pass nc;
+};
+
+// ---- construction and destruction -------------------------------------------------------
+
+// obligation: never fails requires cap >= 0i64
+//             ensures result.count == 0i64 && result.cap >= 1i64 && result.cap >= cap
+//
+// A NEGATIVE CAPACITY IS A MISUSE AND STOPS; ZERO IS FLOORED TO ONE. A request of 0 is the
+// natural "no size hint" (and an input-sized estimate can be 0), so it builds a usable `Vec`
+// rather than a trap; a negative one can only come from arithmetic gone wrong. The floor is
+// what keeps `cap >= 1` true of every live `Vec`, so that `cap <= 0` can mean freed.
+pub func:vec_init<T: Copy> = Vec<T>(int64:cap) never fails {
+    if (cap < 0i64) { drop vec_oob(cap); }
+    int64:n = cap;
+    if (n < 1i64) { n = 1i64; }
+    wild int8->:mem = alloc(raw vec_bytes::<T>(n));
+    pass Vec{ items: mem =>! wild T->, count: 0i64, cap: n, move_only: [] };
+};
+
+// obligation: never fails requires v.cap > 0i64
+//             ensures v.count == 0i64 && v.cap == 0i64 && v.items == NULL
+//
+// FREES THE BLOCK, WHICH IS THE WHOLE FREE: an element owns nothing (`T: Copy`). It leaves
+// the `Vec` dead -- see the header -- so a second `vec_free` stops here, before `dalloc`.
+pub func:vec_free<T: Copy> = NIL(Vec<T>->:v) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    dalloc(v.items =>! wild int8->);
+    v.items = NULL;
+    v.count = 0i64;
+    v.cap = 0i64;
+    pass NIL;
+};
+
+// ---- capacity ---------------------------------------------------------------------------
+
+// obligation: never fails requires v.cap > 0i64 && need >= 0i64
+//             ensures v.cap >= v.count + need && v.count == old(v.count)
+//
+// ROOM FOR `need` MORE elements beyond `count`, by doubling. The elements move with the
+// block: `ralloc` copies the old block's bytes and frees it.
+pub func:vec_reserve<T: Copy> = NIL(Vec<T>->:v, int64:need) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (need < 0i64) { drop vec_oob(need); }
+    if (need > I64_MAX - v.count) { drop vec_oob(need); }
+    int64:want = v.count + need;
+    if (want <= v.cap) { pass NIL; }
+    int64:nc = raw vec_grown(v.cap, want);
+    wild int8->:bigger = ralloc(v.items =>! wild int8->, raw vec_bytes::<T>(nc));
+    v.items = bigger =>! wild T->;
+    v.cap = nc;
+    pass NIL;
+};
+
+// ---- the checked accessor pair ----------------------------------------------------------
+
+// obligation: never fails requires v.cap > 0i64 && i >= 0i64 && i < v.count
+//
+// BY VALUE: `T: Copy`, so the read is a copy and the slot keeps its element. Its `Vec` is a
+// loan -- read, never changed (NITPICK-TYPE-085) -- so a consumer reads a `Vec` held in a
+// sealed field of its own struct without taking an address.
+pub func:vec_at<T: Copy> = T(Vec<T>:v, int64:i) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (i < 0i64) { drop vec_oob(i); }
+    if (i >= v.count) { drop vec_oob(i); }
+    pass v.items[i];
+};
+
+// obligation: never fails requires v.cap > 0i64 && i >= 0i64 && i < v.count
+//             ensures v.count == old(v.count)
+pub func:vec_set<T: Copy> = NIL(Vec<T>->:v, int64:i, T:x) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (i < 0i64) { drop vec_oob(i); }
+    if (i >= v.count) { drop vec_oob(i); }
+    v.items[i] = x;
+    pass NIL;
+};
+
+// ---- adding and removing ----------------------------------------------------------------
+
+// obligation: never fails requires v.cap > 0i64 ensures v.count == old(v.count) + 1i64
+pub func:vec_push<T: Copy> = NIL(Vec<T>->:v, T:x) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (v.count >= v.cap) {
+        drop vec_reserve(v, 1i64);
+        // `vec_reserve`'s postcondition, checked where the write below relies on it.
+        if (v.count >= v.cap) { drop vec_oob(v.count); }
+    }
+    v.items[v.count] = x;
+    v.count = v.count + 1i64;
+    pass NIL;
+};
+
+// obligation: never fails requires v.cap > 0i64 && v.count > 0i64
+//             ensures v.count == old(v.count) - 1i64
+//
+// THE LAST ELEMENT, by value. An empty `Vec` stops rather than answering a value nobody
+// chose.
+pub func:vec_pop<T: Copy> = T(Vec<T>->:v) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (v.count <= 0i64) { drop vec_oob(v.count); }
+    v.count = v.count - 1i64;
+    pass v.items[v.count];
+};
+
+// obligation: never fails requires v.cap > 0i64 && i >= 0i64 && i <= v.count
+//             ensures v.count == old(v.count) + 1i64
+//
+// `x` AT `i`, the elements from `i` on moved up one, order kept. `i == v.count` is legal --
+// it appends -- so the trap is past it.
+pub func:vec_insert<T: Copy> = NIL(Vec<T>->:v, int64:i, T:x) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (i < 0i64) { drop vec_oob(i); }
+    if (i > v.count) { drop vec_oob(i); }
+    if (v.count >= v.cap) {
+        drop vec_reserve(v, 1i64);
+        if (v.count >= v.cap) { drop vec_oob(v.count); }
+    }
+    // From the top down, so no element is overwritten before it has moved: `j` runs
+    // `count`, `count - 1`, ..., `i + 1`.
+    int64:moved = v.count - i;
+    for (int64:k in 0i64...moved) {
+        int64:j = v.count - k;
+        v.items[j] = v.items[j - 1i64];
+    }
+    v.items[i] = x;
+    v.count = v.count + 1i64;
+    pass NIL;
+};
+
+// obligation: never fails requires v.cap > 0i64 && i >= 0i64 && i < v.count
+//             ensures v.count == old(v.count) - 1i64
+//
+// THE ELEMENT AT `i`, by value, and the ones after it moved down one: order kept, so it is
+// O(count - i). `vec_swap_remove` is the O(1) one.
+pub func:vec_remove<T: Copy> = T(Vec<T>->:v, int64:i) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (i < 0i64) { drop vec_oob(i); }
+    if (i >= v.count) { drop vec_oob(i); }
+    T:out = v.items[i];
+    int64:last = v.count - 1i64;
+    for (int64:j in i...last) {
+        v.items[j] = v.items[j + 1i64];
+    }
+    v.count = last;
+    pass out;
+};
+
+// obligation: never fails requires v.cap > 0i64 && i >= 0i64 && i < v.count
+//             ensures v.count == old(v.count) - 1i64
+//
+// THE ELEMENT AT `i`, by value, and the LAST element moved into its place: O(1), and it does
+// NOT keep order -- a caller that needs order and takes this one gets a reordered `Vec` that
+// no test of the `Vec` alone would catch.
+pub func:vec_swap_remove<T: Copy> = T(Vec<T>->:v, int64:i) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (i < 0i64) { drop vec_oob(i); }
+    if (i >= v.count) { drop vec_oob(i); }
+    T:out = v.items[i];
+    int64:last = v.count - 1i64;
+    v.items[i] = v.items[last];
+    v.count = last;
+    pass out;
+};
+
+// ---- bulk operations --------------------------------------------------------------------
+
+// obligation: never fails requires v.cap > 0i64 && n >= 0i64
+//             ensures (n < old(v.count) && v.count == n) || (n >= old(v.count) && v.count == old(v.count))
+//
+// KEEP THE FIRST `n`: a truncation to `n >= count` changes nothing (it never grows). The
+// capacity is kept.
+pub func:vec_truncate<T: Copy> = NIL(Vec<T>->:v, int64:n) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (n < 0i64) { drop vec_oob(n); }
+    if (n < v.count) { v.count = n; }
+    pass NIL;
+};
+
+// obligation: never fails requires v.cap > 0i64 ensures v.count == 0i64
+//
+// The capacity is kept, so a `Vec` reused across parses clears rather than reallocates.
+pub func:vec_clear<T: Copy> = NIL(Vec<T>->:v) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    v.count = 0i64;
+    pass NIL;
+};
+
+// obligation: never fails requires v.cap > 0i64 && n >= 0i64
+//             ensures v.count == n && v.cap >= n
+//
+// `n` COPIES OF `x`, AND NOTHING ELSE: afterwards the `Vec` holds exactly `n` elements, every
+// one `x` -- grown to `n` if it held fewer, cut to `n` if it held more, every old element
+// overwritten. It is the one way to build a table of `n` equal entries ready to be indexed,
+// and with `n == v.count` it overwrites every element in place.
+pub func:vec_fill<T: Copy> = NIL(Vec<T>->:v, int64:n, T:x) never fails {
+    if (v.cap <= 0i64) { drop vec_oob(v.cap); }
+    if (n < 0i64) { drop vec_oob(n); }
+    if (n > v.cap) {
+        drop vec_reserve(v, n - v.count);
+        if (n > v.cap) { drop vec_oob(n); }
+    }
+    for (int64:k in 0i64...n) {
+        v.items[k] = x;
+    }
+    v.count = n;
+    pass NIL;
+};
diff --git a/tests/unit/vec_accessors.npk b/tests/unit/vec_accessors.npk
new file mode 100644
index 0000000..d41fece
--- /dev/null
+++ b/tests/unit/vec_accessors.npk
@@ -0,0 +1,100 @@
+// expect-exit: 0
+//
+// `Vec<int64>` -- EVERY ACCESSOR AT INDEX 0 AND AT `count - 1`, IN RANGE (`src/core/vec.npk`).
+//
+// The third boundary, `i == count` (and `count + 1` for `vec_insert`, for which `count` is
+// legal), is a TRAP and cannot be followed by an assertion, so each is a program of its own:
+// `vec_*_count_traps.npk`, `vec_insert_past_count_traps.npk`, `vec_at_empty_traps.npk`,
+// `vec_pop_empty_traps.npk`, beside `vec_at_negative_traps.npk` for the sign.
+//
+// Asserts, with every element read back after every change so a write to the wrong slot cannot
+// pass: `vec_at` at 0, `count - 1` and between (10-12); `vec_set` at 0 and `count - 1`, the
+// middle untouched (13-16); `vec_insert` at 0 shifting everything up (17-20), at `count`
+// appending, through a growth from capacity 4 (21-23), and one before the last (24, 25);
+// `vec_remove` at 0, at `count - 1` and between, returning the element and keeping order
+// (26-34); `vec_swap_remove` at 0 -- the last element moves into the hole -- and at
+// `count - 1` (35-41); `vec_pop` to empty (42, 43); and a push after it (44). Then the free,
+// and `exit 0`.
+mod:vec_accessors;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(4i64);
+    drop vec_push(@v, 10i64);
+    drop vec_push(@v, 20i64);
+    drop vec_push(@v, 30i64);
+    // [10, 20, 30]
+    if ((raw vec_at(v, 0i64)) != 10i64)                     { exit 10i32; }
+    if ((raw vec_at(v, v.count - 1i64)) != 30i64)           { exit 11i32; }
+    if ((raw vec_at(v, 1i64)) != 20i64)                     { exit 12i32; }
+
+    drop vec_set(@v, 0i64, 11i64);
+    drop vec_set(@v, v.count - 1i64, 31i64);
+    // [11, 20, 31]
+    if ((raw vec_at(v, 0i64)) != 11i64)                     { exit 13i32; }
+    if ((raw vec_at(v, 2i64)) != 31i64)                     { exit 14i32; }
+    if ((raw vec_at(v, 1i64)) != 20i64)                     { exit 15i32; }
+    if (v.count != 3i64)                                    { exit 16i32; }
+
+    drop vec_insert(@v, 0i64, 5i64);
+    // [5, 11, 20, 31]
+    if ((raw vec_at(v, 0i64)) != 5i64)                      { exit 17i32; }
+    if ((raw vec_at(v, 1i64)) != 11i64)                     { exit 18i32; }
+    if ((raw vec_at(v, 3i64)) != 31i64)                     { exit 19i32; }
+    if (v.count != 4i64)                                    { exit 20i32; }
+    drop vec_insert(@v, v.count, 40i64);
+    // [5, 11, 20, 31, 40] -- the block was full at 4 and doubled
+    if ((raw vec_at(v, 4i64)) != 40i64)                     { exit 21i32; }
+    if (v.count != 5i64)                                    { exit 22i32; }
+    if (v.cap != 8i64)                                      { exit 23i32; }
+    drop vec_insert(@v, v.count - 1i64, 35i64);
+    // [5, 11, 20, 31, 35, 40]
+    if ((raw vec_at(v, 4i64)) != 35i64)                     { exit 24i32; }
+    if ((raw vec_at(v, 5i64)) != 40i64)                     { exit 25i32; }
+
+    if ((raw vec_remove(@v, 0i64)) != 5i64)                 { exit 26i32; }
+    // [11, 20, 31, 35, 40]
+    if ((raw vec_at(v, 0i64)) != 11i64)                     { exit 27i32; }
+    if (v.count != 5i64)                                    { exit 28i32; }
+    if ((raw vec_remove(@v, v.count - 1i64)) != 40i64)      { exit 29i32; }
+    // [11, 20, 31, 35]
+    if (v.count != 4i64)                                    { exit 30i32; }
+    if ((raw vec_at(v, 3i64)) != 35i64)                     { exit 31i32; }
+    if ((raw vec_remove(@v, 1i64)) != 20i64)                { exit 32i32; }
+    // [11, 31, 35]
+    if ((raw vec_at(v, 1i64)) != 31i64)                     { exit 33i32; }
+    if ((raw vec_at(v, 2i64)) != 35i64)                     { exit 34i32; }
+
+    if ((raw vec_swap_remove(@v, 0i64)) != 11i64)           { exit 35i32; }
+    // [35, 31] -- the last element took the hole
+    if ((raw vec_at(v, 0i64)) != 35i64)                     { exit 36i32; }
+    if ((raw vec_at(v, 1i64)) != 31i64)                     { exit 37i32; }
+    if (v.count != 2i64)                                    { exit 38i32; }
+    if ((raw vec_swap_remove(@v, v.count - 1i64)) != 31i64) { exit 39i32; }
+    // [35]
+    if (v.count != 1i64)                                    { exit 40i32; }
+    if ((raw vec_at(v, 0i64)) != 35i64)                     { exit 41i32; }
+
+    if ((raw vec_pop(@v)) != 35i64)                         { exit 42i32; }
+    if (v.count != 0i64)                                    { exit 43i32; }
+    drop vec_push(@v, 7i64);
+    if ((raw vec_at(v, 0i64)) != 7i64)                      { exit 44i32; }
+    drop vec_free(@v);
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/vec_at_after_free_traps.npk b/tests/unit/vec_at_after_free_traps.npk
new file mode 100644
index 0000000..53c1874
--- /dev/null
+++ b/tests/unit/vec_at_after_free_traps.npk
@@ -0,0 +1,37 @@
+// expect-exit: 94
+//
+// `vec_at` ON A FREED `Vec` STOPS `OutOfBounds` -- A USE AFTER FREE IS A TRAP.
+//
+// `vec_free` leaves the `Vec` dead (`cap == 0`), and every verb checks that first; without it a
+// read would go through a pointer to a released block.
+//
+// 94 is the failsafe's `OutOfBounds` arm, the language's own identity, which
+// `vec_oob` raises: reaching it IS the assertion. Were the call to return, `main` would
+// release what it made and end 50 -- never 94 -- so "the check fired" and "the check is
+// gone" cannot look alike. One case per file, because nothing runs after a trap.
+mod:vec_at_after_free_traps;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(4i64);
+    drop vec_push(@v, 1i64);
+    drop vec_free(@v);
+    discard(raw vec_at(v, 0i64));
+    exit 50i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
