diff --git a/tests/unit/vec_leak_forgotten_free.npk b/tests/unit/vec_leak_forgotten_free.npk
new file mode 100644
index 0000000..88b54d0
--- /dev/null
+++ b/tests/unit/vec_leak_forgotten_free.npk
@@ -0,0 +1,47 @@
+// expect-exit: 96
+//
+// THE LEAK CONTROL'S FAILING HALF: a `Vec` whose `vec_free` is FORGOTTEN, and `exit 0` must
+// trap `WildLeak` (96) -- `vec_leak_freed.npk` with the free of `c` left out.
+//
+// This is what makes "the units exit 0" a gate on the `wild` half and not a hope: if a missing
+// free passed, every unit's 0 would prove nothing about its frees. It also measures that the
+// drop the compiler generates for a `Vec` -- an owning type, through its zero-length
+// `string[0]` marker -- frees nothing: the block is released by `vec_free` alone, so this
+// program ends 96 and not 0. The exits before the last are 10 and 11, never 96, so a 96 can
+// only come from the leak check.
+mod:vec_leak_forgotten_free;
+
+use "../../src/core/vec.npk".*;
+
+#[derive(Copy)]
+struct:Cell = { int64:lo; int64:hi; };
+
+func:main = int32(cstring[]:_~argv) {
+    int64:before = wild_live_count();
+    Vec<int64>:a = raw vec_init::<int64>(1i64);
+    Vec<Cell>:c = raw vec_init::<Cell>(1i64);
+    for (int64:i in 0i64...1000i64) {
+        drop vec_push(@a, i);
+        drop vec_push(@c, Cell{ lo: i, hi: i + 1i64 });
+    }
+    if (wild_live_count() != before + 2i64)                 { exit 10i32; }
+    drop vec_free(@a);
+    if (wild_live_count() != before + 1i64)                 { exit 11i32; }
+    // `c` is not freed: the leak under test.
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
diff --git a/tests/unit/vec_leak_freed.npk b/tests/unit/vec_leak_freed.npk
