@@ -0,0 +1,58 @@
+// expect-exit: 0
+//
+// `Vec<T>` GROWTH FROM CAPACITY 1 TO 100 000 ELEMENTS, WITH `count` AND `cap` CHECKED AT EVERY
+// PUSH (`meta/specs/BUILD.md` B-12; `src/core/vec.npk`).
+//
+// Asserts: a `Vec` made at capacity 1 is empty with capacity 1 (10, 11); after every push the
+// count is one more (12) and the capacity holds it (13); the capacity changes only by exactly
+// doubling (14), and only at the push that found the block full (15) -- so growth is amortised
+// linear, never by one; seventeen doublings take 1 to 131 072, the first power of two past
+// 100 000 (16, 17); every element survived every reallocation, read back by `vec_at` (18); and
+// `vec_free` leaves the `Vec` dead, `count` and `cap` 0 (19, 20). Then `exit 0`, which traps
+// `WildLeak` (96) if any block is still live -- so the free is asserted too.
+mod:vec_growth;
+
+use "../../src/core/vec.npk".*;
+
+func:main = int32(cstring[]:_~argv) {
+    Vec<int64>:v = raw vec_init::<int64>(1i64);
+    if (v.count != 0i64)                                    { exit 10i32; }
+    if (v.cap != 1i64)                                      { exit 11i32; }
+    int64:grows = 0i64;
+    int64:seen_cap = v.cap;
+    for (int64:i in 0i64...100000i64) {
+        drop vec_push(@v, i * 3i64);
+        if (v.count != i + 1i64)                            { exit 12i32; }
+        if (v.cap < v.count)                                { exit 13i32; }
+        if (v.cap != seen_cap) {
+            if (v.cap != seen_cap * 2i64)                   { exit 14i32; }
+            if (i != seen_cap)                              { exit 15i32; }
+            grows = grows + 1i64;
+            seen_cap = v.cap;
+        }
+    }
+    if (grows != 17i64)                                     { exit 16i32; }
+    if (v.cap != 131072i64)                                 { exit 17i32; }
+    for (int64:j in 0i64...100000i64) {
+        if ((raw vec_at(v, j)) != j * 3i64)                 { exit 18i32; }
+    }
+    drop vec_free(@v);
+    if (v.count != 0i64)                                    { exit 19i32; }
+    if (v.cap != 0i64)                                      { exit 20i32; }
+    exit 0i32;
+};
+
+func:failsafe = int32(Error:e) {
+    pick (e) {
+        (HeapBadRequest)    { exit 91i32; },
+        (HeapOom)           { exit 92i32; },
+        (IntOverflow)       { exit 93i32; },
+        (OutOfBounds)       { exit 94i32; },
+        (Unreachable)       { exit 95i32; },
+        (WildLeak)          { exit 96i32; },
+        (StackExhausted)    { exit 106i32; },
+        (MachineFault)      { exit 107i32; },
+        (*)                 { exit 99i32; }
+    }
+    exit 9i32;
+};
